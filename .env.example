# Copie ce fichier en .env puis remplis-le. Ne JAMAIS committer le .env.

# Connexion d'Oana : prénom + âge (insensible aux majuscules/accents)
OANA_NAME=Oana
OANA_AGE=26

# Mot de passe de la page /regie (12 caractères minimum)
# Génère-en un : openssl rand -base64 18
ADMIN_PASSWORD=

# URL publique (sert au QR code)
PUBLIC_URL=https://anniv.midjix-lab.com

# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels > ton tunnel > Docker)
CLOUDFLARE_TUNNEL_TOKEN=
